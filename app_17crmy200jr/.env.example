# ============================================
# 牧唐行政资产盘点看板 - 环境变量配置
# ============================================
# 复制此文件为 .env 并填入实际值
# 切勿将 .env 文件提交到版本控制

# ---- 应用配置 ----
NODE_ENV=development
PORT=3000
APP_NAME=牧唐行政资产盘点看板
APP_VERSION=1.0.0

# ---- 数据库配置 ----
DATABASE_URL=postgresql://username:password@localhost:5432/database_name
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=username
DATABASE_PASSWORD=password
DATABASE_NAME=database_name

# ---- Redis 缓存配置 ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TLS_ENABLED=false
CACHE_TTL=300

# ---- 飞书应用配置 ----
# 请在飞书开放平台创建应用后获取
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
FEISHU_APP_ENCRYPT_KEY=
FEISHU_APP_VERIFICATION_TOKEN=

# ---- 飞书多维表格配置 ----
FEISHU_BITABLE_APP_TOKEN=xxxxxxxxxxxxxxxx
FEISHU_BITABLE_TABLE_ID=xxxxxxxxxxxxxxxx

# ---- 认证配置 ----
JWT_SECRET=please-change-this-to-a-random-secret-key
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=please-change-this-to-another-random-secret-key
JWT_REFRESH_EXPIRES_IN=30d

# ---- 安全配置 ----
SESSION_SECRET=please-change-this-session-secret
COOKIE_SECRET=please-change-this-cookie-secret
CORS_ORIGIN=http://localhost:3000

# ---- 监控配置 ----
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1

# ---- 日志配置 ----
LOG_LEVEL=info
LOG_FORMAT=json
LOG_FILE_PATH=./logs/app.log

# ---- 测试配置 ----
E2E_BASE_URL=http://localhost:3000
E2E_HEADLESS=true